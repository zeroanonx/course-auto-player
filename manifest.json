{
  "manifest_version": 3,
  "name": "课程自动连播助手",
  "version": "1.3.0",
  "description": "自动连播全部课时，自动展开章节；自动播放或切换被拦截时自动刷新页面继续，全部完成后暂停（仅对 hbnun.lsedu.vip 生效）。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://hbnun.lsedu.vip/*"
  ],
  "action": {
    "default_title": "课程自动连播助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hbnun.lsedu.vip/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
