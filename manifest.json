{
  "manifest_version": 3,
  "name": "课程自动连播助手",
  "version": "1.4.0",
  "description": "检测视频播放后自动接管，每节随机 5~10 秒播完并自动连播；浮窗可拖动、缩放和覆盖视频区（仅对 hbnun.lsedu.vip 生效）。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://hbnun.lsedu.vip/*"
  ],
  "action": {
    "default_title": "课程自动连播助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hbnun.lsedu.vip/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
