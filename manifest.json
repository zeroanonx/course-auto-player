{
  "manifest_version": 3,
  "name": "课程自动连播 + 考试自动答题助手",
  "version": "1.5.0",
  "description": "课程视频自动连播；考试/作业两遍作答（先取标准答案再按答案作答）。仅对 hbnun.lsedu.vip 生效。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://hbnun.lsedu.vip/*",
    "https://adulteduapi.lsedu.vip/*"
  ],
  "action": {
    "default_title": "课程自动连播 + 考试自动答题",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hbnun.lsedu.vip/*"
      ],
      "js": [
        "content.js",
        "exam.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
